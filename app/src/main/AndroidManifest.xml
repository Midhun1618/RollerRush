<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RollerRushApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.RollerRush">

        <!-- Every screen is locked to landscape. sensorLandscape allows both landscape directions. -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainMenuActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.CharacterActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.ShopActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.SettingsActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.GameActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.GameOverActivity" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- Pause is a translucent activity drawn on top of the (frozen) game. -->
        <activity android:name=".ui.PauseActivity" android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.RollerRush.Pause"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
