<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skate_inferno"
    android:layout_width="150dp"
    android:layout_height="130dp"
    android:background="@drawable/bg_shop_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/skate_image"
        android:layout_width="125dp"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="INFERNO"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/skate_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="INFERNO"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/skate_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="SELECT"
        android:textColor="#AAB8C8"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
