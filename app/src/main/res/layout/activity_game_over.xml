<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameOverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg02">

    <!-- TOP-RIGHT: RUSH RUBIES -->
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_margin="12dp"
        android:background="@drawable/coin_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@id/linearLayout2"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Rush Rubies"
            android:src="@drawable/rush_ruby" />

        <TextView
            android:id="@+id/rubiesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/count_font"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- TOP-RIGHT: COINS -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_margin="12dp"
        android:background="@drawable/coin_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Rush Coins"
            android:src="@drawable/rush_coin" />

        <TextView
            android:id="@+id/totalCoinsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/count_font"
            android:text="0"
            android:textColor="#FFD34B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BOTTOM-RIGHT: NAVIGATION BUTTONS -->
    <LinearLayout
        android:id="@+id/linearLayout11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/homeButton"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/blue_button_bg"
            android:fontFamily="@font/new_font"
            android:text="HOME"
            android:textColor="#1A6690"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playAgainButton"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/retry_button_bg"
            android:fontFamily="@font/new_font"
            android:text="PLAY AGAIN"
            android:textColor="#0E6D33"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LEFT: STATS AREA -->
    <LinearLayout
        android:id="@+id/linearLayout12"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="300dp"
        android:layout_height="90dp"
        android:contentDescription="Score board"
        android:src="@drawable/golden_button_bg"
        app:layout_constraintBottom_toBottomOf="@id/linearLayout12"
        app:layout_constraintEnd_toEndOf="@id/linearLayout12"
        app:layout_constraintStart_toStartOf="@id/linearLayout12"
        app:layout_constraintTop_toTopOf="@id/linearLayout12" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/new_font"
        android:text="DISTANCE"
        android:textColor="#6B5A4F"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/imageView4"
        app:layout_constraintEnd_toEndOf="@id/linearLayout12"
        app:layout_constraintStart_toStartOf="@id/linearLayout12" />

    <TextView
        android:id="@+id/distanceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/new_font"
        android:paddingHorizontal="40dp"
        android:paddingVertical="8dp"
        android:text="0 m"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/linearLayout12"
        app:layout_constraintEnd_toEndOf="@id/linearLayout12"
        app:layout_constraintStart_toStartOf="@id/linearLayout12"
        app:layout_constraintTop_toTopOf="@id/linearLayout12" />

    <LinearLayout
        android:id="@+id/linearLayout14"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/textView2"
        app:layout_constraintStart_toStartOf="@id/imageView4">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:text="BEST SCORE"
            android:textColor="#3C4456"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/bestValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:text="0"
            android:textColor="#FFCC57"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/runCoinsValue"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/new_font"
        android:gravity="center"
        android:shadowRadius="5"
        android:text="+0 COINS THIS RUN"
        android:textColor="#FFD66B"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/linearLayout12"
        app:layout_constraintStart_toStartOf="@id/linearLayout12"
        app:layout_constraintTop_toBottomOf="@id/imageView4" />

    <LinearLayout
        android:id="@+id/scoreStats"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/linearLayout12"
        app:layout_constraintStart_toStartOf="@id/linearLayout12"
        app:layout_constraintTop_toBottomOf="@id/runCoinsValue">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:text="SCORE"
            android:textColor="#9AFFCD"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/scoreValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/count_font"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RIGHT: DEFAULT GAME OVER IMAGE -->

    <ScrollView
        android:id="@+id/completedMissionsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout12"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <LinearLayout
            android:id="@+id/completedMissionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ImageView
        android:id="@+id/gameOverTitle"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:contentDescription="Game Over"
        android:scaleType="fitCenter"
        android:src="@drawable/game_over_img"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- RIGHT: COMPLETED MISSIONS PANEL -->
    <LinearLayout
        android:id="@+id/completedMissionsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/mission_panel"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/linearLayout11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/linearLayout12"
        app:layout_constraintTop_toBottomOf="@id/linearLayout3">

        <TextView
            android:id="@+id/completedMissionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="MISSIONS COMPLETED!"
            android:textColor="#FFD34B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/completedMissionsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/count_font"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Great ride! You've unlocked new rewards."
            android:textColor="#B9C9DD"
            android:textSize="13sp" />


        <TextView
            android:id="@+id/completedMissionsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/count_font"
            android:gravity="center"
            android:text="Visit MISSIONS from the main menu to claim your rewards."
            android:textColor="#65D8FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- MYSTERY REWARD OVERLAY -->
    <LinearLayout
        android:id="@+id/mysteryRewardCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="@drawable/mystery_overlay_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/mysteryBubbleImage"
            android:layout_width="160dp"
            android:layout_height="250dp"
            android:contentDescription="Mystery reward bubble"
            android:scaleType="fitCenter"
            android:src="@drawable/mystery_bubble" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="28dp"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/new_font"
                android:text="LUCKY FIND"
                android:textColor="#E8D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mysteryRewardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/new_font"
                android:text="MYSTERY REWARD!"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mysteryRewardValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/new_font"
                android:padding="12dp"
                android:text="+100 COINS"
                android:textColor="#FFD66B"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
