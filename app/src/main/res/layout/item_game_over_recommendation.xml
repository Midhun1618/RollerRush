<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameOverRecommendationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- SKATE RECOMMENDATION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/skateRecommendationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gon">

        <FrameLayout
            android:id="@+id/recommendationArtworkFrame"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/recommendationUnlockLevel">

            <View
                android:id="@+id/recommendationGlow"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="#263A8DFF" />

            <ImageView
                android:id="@+id/recommendationSkateImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="Recommended skate"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/recommendationSkateName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="SKATE NAME"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recommendationArtworkFrame" />

        <TextView
            android:id="@+id/recommendationUnlockLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UNLOCKED AT LEVEL 2"
            android:textColor="#96BEFF"
            android:fontFamily="@font/count_font"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/recommendationPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:rotation="-4"
            android:text="1,200 COINS"
            android:textColor="#FFD34B"
            android:fontFamily="@font/count_font"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/recommendationStats"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.72"
            app:layout_constraintStart_toStartOf="@+id/recommendationArtworkFrame" />


        <TextView
            android:id="@+id/recommendationStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:fontFamily="@font/new_font"
            android:rotation="6"
            android:text="SPEED +10%"
            android:textColor="#69DCFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/recommendationArtworkFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.34"
            app:layout_constraintStart_toStartOf="@+id/recommendationArtworkFrame" />

        <TextView
            android:id="@+id/recommendationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/new_font"
            android:gravity="center"
            android:text="700 MORE COINS NEEDED"
            android:textColor="#FFCD5A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recommendationArtworkFrame" />

        <ProgressBar
            android:id="@+id/recommendationCoinProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="18dp"
            android:max="1200"
            android:progress="500"
            android:progressBackgroundTint="#475A6E"
            android:progressTint="#FFD119"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent" />

        <Button
            android:id="@+id/recommendationShopButton"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:backgroundTint="#FFD34B"
            android:text="VISIT SHOP"
            android:fontFamily="@font/count_font"
            android:textAllCaps="true"
            android:textColor="#14232D"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recommendationSkateName" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NEXT-LEVEL RECOMMENDATION -->
    <LinearLayout
        android:id="@+id/nextLevelRecommendationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp"
        android:background="#263A8DFF"
        android:visibility="gone">

        <TextView
            android:id="@+id/nextLevelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LEVEL 3"
            android:textColor="#73CDFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextLevelRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="2,500 MORE XP TO GO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/nextLevelProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:max="10000"
            android:progress="2500"
            android:progressTint="#50C8FF"
            android:progressBackgroundTint="#475A6E" />

        <TextView
            android:id="@+id/nextLevelProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="5,000 / 7,500 XP"
            android:textColor="#CDDCF5"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
