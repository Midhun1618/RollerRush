<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/purchase_dialog_root"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:minWidth="420dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="UNLOCKED!"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Ice Glide"
        android:textColor="#C9D4E1"
        android:textSize="17sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/dialog_particle_field"
        android:layout_width="330dp"
        android:layout_height="155dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/dialog_skate_image"
            android:layout_width="235dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/dialog_equipped"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="EQUIPPED"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_continue"
        android:layout_width="190dp"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:text="CONTINUE"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
