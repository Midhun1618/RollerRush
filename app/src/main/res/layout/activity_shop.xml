<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blue_grad">

    <!-- BACK -->

    <TextView
        android:id="@+id/shop_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TITLE -->

    <TextView
        android:id="@+id/shop_title"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="SHOP"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toEndOf="@id/shop_back_button"
        app:layout_constraintTop_toTopOf="@id/shop_back_button"
        app:layout_constraintBottom_toBottomOf="@id/shop_back_button" />

    <!-- COINS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:layout_margin="15dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:background="@drawable/coin_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/rush_coin"/>
        <TextView
            android:id="@+id/coins_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFD34B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>


    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shop_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="40dp"
                android:gravity="center_vertical"
                android:letterSpacing="0.07"
                android:text="SKATES"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/shop_skate_selector"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginBottom="5dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shop_title">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <View
                        android:layout_width="20dp"
                        android:layout_height="0dp" />


                    <!-- RED -->

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/selector_card1"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shop_item_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_margin="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/card_texture_bg_1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/selector_name1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="RED STREET"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/selector_skate1"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_margin="10dp"
                            android:rotation="40"
                            android:scaleType="fitCenter"
                            android:src="@drawable/skate1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/selector_card2"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shop_equipped_item_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_margin="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/card_texture_bg_2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/selector_name2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/grey_container"
                            android:paddingHorizontal="8dp"
                            android:text="LOCKED"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/selector_skate2"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_margin="10dp"
                            android:rotation="40"
                            android:scaleType="fitCenter"
                            android:src="@drawable/skate2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- AERO -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/selector_card3"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shop_item_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_margin="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/card_texture_bg_3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/selector_name3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/grey_container"
                            android:paddingHorizontal="8dp"
                            android:text="LOCKED"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/selector_skate3"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="12dp"
                            android:rotation="40"
                            android:scaleType="fitCenter"
                            android:src="@drawable/skate3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- INFERNO -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/selector_card4"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shop_item_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_margin="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/card_texture_bg_4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/selector_name4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/grey_container"
                            android:paddingHorizontal="8dp"
                            android:text="LOCKED"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/selector_skate4"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="12dp"
                            android:rotation="40"
                            android:scaleType="fitCenter"
                            android:src="@drawable/skate4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- VOLT -->

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/selector_card5"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shop_item_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_margin="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/card_texture_bg_5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/selector_name5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/grey_container"
                            android:paddingHorizontal="8dp"
                            android:text="LOCKED"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/selector_skate5"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="12dp"
                            android:rotation="40"
                            android:scaleType="fitCenter"
                            android:src="@drawable/skate5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </HorizontalScrollView>
        </LinearLayout>


    </ScrollView>

    <LinearLayout
        android:id="@+id/info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_overlay"
        android:gravity="center"
        android:alpha="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/scrollView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/skate_info_card"
            android:layout_width="500dp"
            android:layout_height="330dp"
            android:background="@drawable/skate_card_info">

            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" >
                <TextView
                    android:id="@+id/name_skate_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:text="INFERNO"/>
                <TextView
                    android:id="@+id/subtitle_skate_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="Flame and Fire with Speed"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textSize="12sp"
                    android:text="Speed"/>
                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/speed_meter"
                    android:layout_width="180sp"
                    android:layout_height="16dp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressTint="#FFEDD1"
                    android:progress="38"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:text="Power"/>
                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/power_meter"
                    android:layout_width="180sp"
                    android:layout_height="16dp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressTint="#FFEDD1"
                    android:progress="78"/>

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginRight="8dp"
                        android:src="@drawable/rush_coin" />

                    <TextView
                        android:id="@+id/price_skate_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,499"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/bgcard_skateinfo"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_margin="28dp"
                android:src="@drawable/card_texture_bg_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@+id/skateimg_skateinfo"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_margin="28dp"
                android:rotation="40"
                android:src="@drawable/skate4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



            <Button
                android:id="@+id/buyBtn"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_margin="20dp"
                android:backgroundTint="#E4B011"
                android:text="BUY NOW"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bgcard_skateinfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>