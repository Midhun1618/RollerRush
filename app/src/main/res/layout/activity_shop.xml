<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shopRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/shop_bg_img"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/shopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShopBack"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="HOME"
            android:fontFamily="@font/new_font"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/violet_button_bg"
            android:contentDescription="Return to home screen" />

        <TextView
            android:id="@+id/tvShopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="SKATE MARKET"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- CURRENCY -->
        <LinearLayout
            android:id="@+id/currencyBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/coin_container"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/rush_ruby"
                    android:contentDescription="Rush Rubies" />

                <TextView
                    android:id="@+id/tvShopRubies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/coin_container"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/rush_coin"
                    android:contentDescription="Coins" />

                <TextView
                    android:id="@+id/tvShopCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFD34B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CATEGORY FILTERS -->
    <LinearLayout
        android:id="@+id/shopCategoryTabs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="5">

        <Button
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="ALL"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/silver_button_bg" />

        <Button
            android:id="@+id/btnStarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="STARTER"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/silver_button_bg" />

        <Button
            android:id="@+id/btnPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="PRO"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/silver_button_bg" />

        <Button
            android:id="@+id/btnApex"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="APEX"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/silver_button_bg" />

        <Button
            android:id="@+id/btnMythic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="MYTHIC"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="@font/new_font"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/silver_button_bg" />
    </LinearLayout>

    <!-- VERTICAL SHOP COLLECTION -->
    <ScrollView
        android:id="@+id/shopScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/shopContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="16dp" />

    </ScrollView>

</LinearLayout>