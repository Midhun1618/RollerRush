
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- Header -->
    <TextView
        android:id="@+id/tvShopTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="SHOP"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/currencyBar" />

    <!-- Currency counters -->
    <LinearLayout
        android:id="@+id/currencyBar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvShopCoins"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="🪙 5,333"
            android:textColor="#FFD65A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShopRubies"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="💎 10"
            android:textColor="#E5A3FF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Category tabs -->
    <LinearLayout
        android:id="@+id/shopCategoryTabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/currencyBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSkates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="SKATES"
            android:textStyle="bold"
            android:textColor="#111827"
            android:backgroundTint="#FFD044" />

        <Button
            android:id="@+id/btnHelmets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:text="HELMETS"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#26354D" />

        <Button
            android:id="@+id/btnSuits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="SUITS"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#26354D" />

    </LinearLayout>

    <!-- Collection heading -->
    <TextView
        android:id="@+id/tvCollectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="LATEST COLLECTION"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/shopCategoryTabs"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Product cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShopProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tvCollectionTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
